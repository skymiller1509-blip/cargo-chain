{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "title": "VerifyResponse",
  "type": "object",
  "required": [
    "checkpoint_count",
    "reason",
    "shipment_id",
    "verified"
  ],
  "properties": {
    "checkpoint_count": {
      "type": "integer",
      "format": "uint32",
      "minimum": 0.0
    },
    "reason": {
      "type": "string"
    },
    "shipment_id": {
      "type": "string"
    },
    "verified": {
      "type": "boolean"
    }
  },
  "additionalProperties": false
}
